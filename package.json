{
  "name": "TrueLazer",
  "version": "0.1.8",
  "description": "development build",
  "main": "main.js",
  "scripts": {
    "start-renderer": "vite",
    "start": "concurrently --kill-others \"npm run start-renderer\" \"cross-env NODE_ENV=development electron .\"",
    "build-native": "node-gyp rebuild --directory native",
    "patches": "patch-package",
    "postinstall": "npm run patches && npm run build-native",
    "build": "vite build && electron-builder --publish never",
    "smoke": "electron main/smoke-electron.cjs",
    "test": "vitest run"
  },
  "overrides": {
    "better-sqlite3": "13.0.3"
  },
  "build": {
    "appId": "com.truelazer.app",
    "productName": "TrueLazer",
    "copyright": "Copyright © 2026 ${author}",
    "directories": {
      "output": "release/",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "main/**/*",
      "preload.js",
      "src/favicon.ico",
      "src/**/*",
      "dist/**/*",
      "native/build/Release/ndi_wrapper.node",
      "native/build/Release/Processing.NDI.Lib.x64.dll",
      "!node_modules/better-sqlite3/prebuilds/darwin-*",
      "!node_modules/better-sqlite3/prebuilds/linux-*",
      "!node_modules/better-sqlite3/prebuilds/linuxmusl-*",
      "!node_modules/better-sqlite3/prebuilds/win32-arm64.node",
      "!node_modules/better-sqlite3/build/**",
      "!node_modules/better-sqlite3/deps/**",
      "!node_modules/better-sqlite3/src/**",
      "!node_modules/better-sqlite3-multiple-ciphers/**",
      "!node_modules/jazz-midi/bin/10_15/**",
      "!node_modules/jazz-midi/bin/11_15/**",
      "!node_modules/jazz-midi/bin/linux64",
      "!node_modules/jazz-midi/bin/linuxa7",
      "!node_modules/jazz-midi/bin/macos64",
      "!node_modules/jazz-midi/bin/macosa64",
      "!node_modules/jazz-midi/bin/win32",
      "!node_modules/@serialport/bindings-cpp/prebuilds/android-*",
      "!node_modules/@serialport/bindings-cpp/prebuilds/darwin-*",
      "!node_modules/@serialport/bindings-cpp/prebuilds/linux-*",
      "!node_modules/@serialport/bindings-cpp/prebuilds/win32-ia32"
    ],
    "extraFiles": [
      {
        "from": "src/",
        "to": "Mappings",
        "filter": [
          "*Mappings.json"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "src/ILDA-FILE-FORMAT-FILES",
        "to": "ILDA-FILES"
      },
      {
        "from": "src/fonts",
        "to": "fonts"
      }
    ],
    "asarUnpack": [
      "**/*.node",
      "**/*.dll"
    ],
    "win": {
      "icon": "src/favicon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "LICENSE"
    }
  },
  "keywords": [],
  "author": "PT. Temple Tunes Entertainment, CTO Kevin Bahr (MAXQON)",
  "license": "Source Available",
  "type": "module",
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "electron": "^42.11.8",
    "electron-builder": "^26.15.3",
    "patch-package": "^8.0.1",
    "vite": "^7.3.6",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@laser-dac/core": "^0.4.2",
    "@laser-dac/ether-dream": "^0.4.2",
    "@mui/material": "^7.3.11",
    "bindings": "^1.5.0",
    "bootstrap-icons": "^1.13.1",
    "dmxnet": "^0.9.0",
    "electron-store": "^11.0.2",
    "font-list": "^2.1.0",
    "get-system-fonts": "^2.0.2",
    "node-addon-api": "^8.9.2",
    "opentype.js": "^1.3.4",
    "osc": "^2.4.5",
    "prolink-connect": "0.11.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stagelinq": "3.5.5",
    "webmidi": "^3.3.1"
  }
}