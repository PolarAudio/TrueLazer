diff --git a/node_modules/stagelinq/dist/sqlite-stub.js b/node_modules/stagelinq/dist/sqlite-stub.js
new file mode 100644
index 0000000..942d279
--- /dev/null
+++ b/node_modules/stagelinq/dist/sqlite-stub.js
@@ -0,0 +1,31 @@
+"use strict";
+/**
+ * TrueLazer vendored patch — sqlite stub for the StageLinq library.
+ *
+ * StageLinq eagerly requires better-sqlite3-multiple-ciphers at module load
+ * (dist/network/NetworkDevice.js, dist/Databases/DbConnection.js). That native
+ * module is built for the Node ABI and cannot load under Electron's ABI, which
+ * would crash the entire TrueLazer main process at import time — even though
+ * TrueLazer only uses StageLinq for transport sync (StateMap + BeatInfo) and
+ * deliberately disables database download / file transfer.
+ *
+ * This stub replaces the native module ONLY for the database/album-art path we
+ * never exercise (downloadDbSources:false, enableFileTranfer:false). If those
+ * features are ever enabled, the throw below names the fix: rebuild the module
+ * for the Electron ABI (@electron/rebuild -w better-sqlite3-multiple-ciphers).
+ *
+ * Re-apply after every `npm install` (same convention as the vendored
+ * prolink-connect watchBeatPackets patch).
+ *
+ * Patched files:
+ *   dist/network/NetworkDevice.js   -> require("better-sqlite3-multiple-ciphers")
+ *   dist/Databases/DbConnection.js  -> require("better-sqlite3-multiple-ciphers")
+ */
+module.exports = function sqliteStub() {
+  throw new Error(
+    "TrueLazer: better-sqlite3-multiple-ciphers is intentionally stubbed for " +
+      "Electron (vended patch). StageLinq database / album-art features are " +
+      "disabled. Rebuild for Electron ABI to enable them."
+  );
+};
+module.exports.default = module.exports;
